{
  "name": "readflow",
  "version": "1.4.0",
  "description": "100% local, smooth neural text-to-speech (Piper WASM) browser extension with customizable dock icon, procedural streaming, and universal auto-read",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs chrome && node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:size": "node scripts/check-size.mjs",
    "docs:api": "npx typedoc --options typedoc.json"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.4.4",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.1",
    "vitest": "^5.1.1"
  }
}
