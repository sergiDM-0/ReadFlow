{
  "manifest_version": 3,
  "name": "EchoSelect TTS",
  "version": "1.0.0",
  "description": "100% local, lightweight text-to-speech for any selected text and streaming AI chats.",
  "browser_specific_settings": {
    "gecko": {
      "id": "echoselect-tts@echoselect.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "optional_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "EchoSelect TTS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-read-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Read selected text or stop active speech"
    }
  }
}
