{
  "manifest_version": 3,
  "name": "ReadFlow",
  "version": "1.3.2",
  "author": "sergiDM-0",
  "homepage_url": "https://sergidm-0.github.io/ReadFlow/",
  "description": "100% local, smooth neural text-to-speech (Piper WASM) with customizable dock icon, procedural streaming, and universal auto-read.",
  "permissions": ["storage", "contextMenus", "activeTab", "offscreen"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ReadFlow — Leer y configurar (Alt+S)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-read-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Read selected text or stop active speech"
    }
  }
}
